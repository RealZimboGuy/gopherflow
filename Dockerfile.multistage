#Run with
#  docker buildx build --platform linux/amd64,linux/arm64 -t juliangpurse/gopherflow:1.9.1 -f Dockerfile.multistage --push .
#
# The build stage runs on the builder's own platform and cross-compiles for
# each target with GOOS/GOARCH. That only works because the binary is pure Go
# (CGO_ENABLED=0): no C toolchain per architecture, and no Go compiler running
# under QEMU emulation, which is what makes multi-arch builds slow.

 #docker run -p 8080:8080 -e GFLOW_DATABASE_TYPE=SQLLITE -e GFLOW_DATABASE_SQLLITE_FILE_NAME=/data/gflow.db -v gflow-data:/data juliangpurse/gopherflow:1.9.1
 #
 # A named volume inherits /data's ownership from the image. A host bind mount
 # does not: it keeps the host's ownership, which the nonroot user below cannot
 # write to. Use --user $(id -u):$(id -g) when bind mounting a host directory.

# Build the application from source
FROM --platform=$BUILDPLATFORM golang:1.26 AS build-stage

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o /gopher-flow cmd/gopherflow/main.go

# Run the tests in the container
FROM build-stage AS run-test-stage
RUN go test -v ./...

# Prepare a writable data directory
FROM --platform=$BUILDPLATFORM busybox AS data-stage
RUN mkdir -p /data

# Deploy the application binary into a lean image
FROM gcr.io/distroless/static-debian12 AS build-release-stage

WORKDIR /

COPY --from=build-stage /gopher-flow /gopher-flow
# Copy a pre-created /data directory and set correct ownership without RUN
COPY --from=data-stage --chown=nonroot:nonroot /data /data

EXPOSE 8080

USER nonroot:nonroot

ENTRYPOINT ["/gopher-flow"]
